# Calculate Xi correlation
ft1_sh_xi <- xicor(ft1_radial_data$convex_hull_area_cm2, ft1_radial_data$sh_eq)
ft2_sh_xi <- xicor(ft2_radial_data$convex_hull_area_cm2, ft2_radial_data$sh_eq)
# Pearson's R
ft1_sh_cor <- cor(ft1_radial_data$convex_hull_area_cm2, ft1_radial_data$sh_eq)
ft2_sh_cor <- cor(ft2_radial_data$convex_hull_area_cm2, ft2_radial_data$sh_eq)
# Label DF
sh_cha_facet_labels = data.frame(
trial = c('FT1', 'FT2'),
x = c(800, 800),
y = c(.92, .92),
label = c(
paste('xi == ', round(ft1_sh_xi, 3), " * ',' * ~ rho == ", round(ft1_sh_cor, 3)),
paste('xi == ', round(ft2_sh_xi, 3), " * ',' * ~ rho == ", round(ft2_sh_cor, 3))
)
)
# paste('xi == ', round(ft1_xi, 4), 'rho == ', round(ft1_cor, 4)),
# paste('xi == ', round(ft2_xi, 4), 'rho == ', round(ft2_cor, 4))
sh_cha_corr_plot <- ggplot(combined_radial_data, aes(x=convex_hull_area_cm2, y=sh_eq, color=rs))+
geom_point(size=3, alpha=.7)+
geom_smooth(method = 'gam', se=TRUE, aes(group=1), color='gray30')+
geom_label(
data=sh_cha_facet_labels,
aes(x=x, y=y, label=label),
parse=TRUE,
inherit.aes = FALSE,
size=3
)+
facet_wrap(~trial)+
scale_color_viridis_d(option='D', begin=.2, end =.9)+
labs(x = expression("Convex Hull Area (cm"^2*")"),
y='SEI',
color='Rootstock')+
theme_minimal()+
theme(axis.text.x = element_text(angle=-30),
strip.text = element_blank())
rs_sh_plot
prop_sh_plot
sh_cha_corr_plot
# rs_prop_asi_plot
cha_multi_plot <- ggarrange(solidity_cha_corr_plot, asi_cha_corr_plot, sh_cha_corr_plot, labels = 'AUTO', ncol=1, common.legend = TRUE)
cha_multi_plot
